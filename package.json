{
  "name": "ebbinghaus-web",
  "private": true,
  "version": "0.1.0",
  "description": "Bot-centred learning app (Grok Bot-style UI baseline) with spaced repetition.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bank": "node scripts/build-bank.mjs",
    "predev": "node scripts/build-bank.mjs --if-missing",
    "dev": "vite",
    "prebuild": "node scripts/build-bank.mjs --if-missing",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "e2e": "node tests/e2e.mjs",
    "artifact": "node scripts/artifact.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
